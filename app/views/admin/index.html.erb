<main class="container">
  <turbo-frame id="refresh_all">
    <%= render "admin/refresh_all" %>
  </turbo-frame>

  <section class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Webcal Subscription Stats</h2>
      <span class="badge bg-primary fs-6">Total Hits: <%= @total_webcal_hits %></span>
    </div>

    <div class="row g-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h3 class="h5">Most-Requested Teams</h3>

            <% if @team_webcal_stats.any? %>
              <div class="table-responsive">
                <table class="table table-striped mb-0">
                  <thead>
                    <tr>
                      <th>Rank</th>
                      <th>Team</th>
                      <th>Hits</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @team_webcal_stats.each_with_index do |stat, index| %>
                      <tr>
                        <td><%= index + 1 %></td>
                        <td><%= stat.team_name %></td>
                        <td><%= stat.hit_count %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="text-muted mb-0">No team hits recorded yet.</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h3 class="h5">Daily Request Volume</h3>

            <% if @daily_webcal_hits.any? %>
              <div class="table-responsive">
                <table class="table table-sm mb-0">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Hits</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @daily_webcal_hits.each do |date, count| %>
                      <tr>
                        <td><%= date %></td>
                        <td><%= count %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="text-muted mb-0">No daily stats available yet.</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>