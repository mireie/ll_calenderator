<section class="splash" aria-labelledby="splash-title">
  <div class="splash__grid" aria-hidden="true"></div>
  <div class="splash__content">
    <p class="splash__eyebrow">KickCal</p>
    <p class="splash__status"><span></span> Project paused</p>
    <h1 id="splash-title">Thanks for stopping by.</h1>
    <p class="splash__message">
      KickCal is discontinued for now that LL allows you to subscribe to calendars directly. If you would like to see this project continue, send a message and let me know.
    </p>
    <%= link_to "Send a message", "https://github.com/mireie/ll_calenderator/issues/new", class: "splash__link", target: "_blank", rel: "noopener" %>
  </div>
  <aside class="splash__note" aria-label="Project note">
    <span class="splash__note-mark">KC</span>
    <p>Maybe later.<br>Not forgotten.</p>
  </aside>
</section>