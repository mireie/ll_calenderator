<%= turbo_stream_from "leagues" %>
<main class="container">
  <div class="header">
    <h1>Active and Upcoming Leagues</h1>
  </div>
  <% if @leagues.none? %>
    <%= render "empty_state" %>
  <% end %>
  <% if @active_leagues.any? %>
    <%= turbo_frame_tag "leagues", class: "leagues" do %>
      <% @leagues_by_sport.each do |sport, leagues|%>
        <h2 class="leagues__sport"><%= sport %></h2>
        <div class="leagues-table-wrapper">
          <table class="leagues-table">
            <thead>
              <tr>
                <th>League</th>
                <th>Start Date</th>
              </tr>
            </thead>
            <tbody>
              <% leagues.each do |league| %>
                <tr>
                  <td data-label="League"><%= link_to league.title, league_path(league), target: "_top" %></td>
                  <td data-label="Start Date"><%= league.start_date.strftime('%m/%d/%Y') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p>There are no upcoming games for any active leagues.</p>
  <% end %>
</main>