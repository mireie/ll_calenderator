<%= simple_form_for [league, team], html: { class: "form team" } do |f| %>
  <%= form_error_notification(team) %>
  <%= f.input :date, html5: true, input_html: { autofocus: true } %>
  <%= link_to "Cancel", league_path(league), class: "btn btn--light" %>
  <%= f.submit class: "btn btn--secondary" %>
<% end %>
