<div class="flex items-center p-4 mx-6 flex-wrap" data-turbo-frame="filter">
  <%= form_with url: public_files_path, method: :get, remote: true, data: { controller: 'filter' } do %>

    <div class="flex items-center">
      <%= label_tag :team_name, 'Team Name', class: "mr-2" %>
      <%= text_field_tag :team_name, params[:team_name], class: "mr-2", data: { action: 'input->filter#submit' } %>
      <%= submit_tag 'Filter', class: 'bg-blue-500 text-white py-2 px-4 rounded' %>
    </div>
  <% end %>
</div>
<div class="flex flex-col">
  <div class="overflow-x-auto">
    <div class="py-2 align-middle min-w-full px-6">
      <div class="shadow overflow-hidden border-b border-gray-200 rounded-lg">
        <div class="bg-gray-200 px-4 py-5 grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="hidden lg:block text-lg font-medium text-gray-900 text-xl">Team</div>
          <div class="hidden lg:block text-lg font-medium text-gray-900 text-xl">League</div>
          <div class="hidden lg:block text-lg font-medium text-gray-900 text-xl">File</div>
        </div>
        <% @files.each do |file| %>
          <div class="px-4 py-5 grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="text-sm text-gray-600 font-semibold text-xl"><%= file[:team_name] %></div>
            <div class="text-sm text-gray-500"><%= file[:league_name] %></div>
            <div class="text-sm text-gray-500">
              <%= link_to "Subscribe to Calendar", "webcal://#{request.host_with_port}/#{file[:path].gsub('public/', '')}", class: "bg-blue-500 text-white py-2 px-4 rounded" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>