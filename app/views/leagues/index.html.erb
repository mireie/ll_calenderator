<%= turbo_stream_from "leagues" %>
<main class="container">
  <div class="header">
    <h1>Leagues</h1>
  </div>
  <% if @leagues.none? %>
    <%= render "empty_state" %>
  <% end %>
  <% if @active_leagues.any? %>
    <h2 class="header">Active Leagues</h2>
    <ul>
      <% @active_leagues.each do |league| %>
        <%= render league %>
      <% end %>
    </ul>
  <% else %>
    <p>There are no upcoming games for any active leagues.</p>
  <% end %>
</main>