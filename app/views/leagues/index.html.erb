<%= turbo_stream_from "leagues" %>
<main class="container">
  <div class="header">
    <h1>Leagues</h1>
  </div>
  <% if @leagues.none? %>
    <%= render "empty_state" %>
  <% end %>
  <%= turbo_frame_tag "leagues" do %>
    <% @leagues_by_sport.each do |sport, leagues|%>
      <h2 class="header"><%= sport %></h2>
      <ul>
        <% leagues.each do |league| %>
          <%= render league %>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</main>