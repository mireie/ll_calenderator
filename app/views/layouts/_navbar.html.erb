<header class="navbar">
  <div class="container">
    <nav class="navbar__nav">
      <span class="navbar__logo">
        <%= link_to "KickCal", root_path %>
      </span> 
      <ul class="navbar__left">
        <li>
          <turbo-frame id="main_content">
            <%= link_to "Organizations", organizations_path, data: { turbo_frame: "_top" } %>
          </turbo-frame>
        </li>
        <li>
          <turbo-frame id="main_content">
            <%= link_to "Leagues", leagues_path, data: { turbo_frame: "_top" } %>
          </turbo-frame>
        </li>
      </ul>

      <ul class="navbar__right">
        <li>
          <% if authenticated? %>
           <div class="dropdown">
            <button class="dropdown-toggle"><%= t('.my_account') %></button>
            <ul class="dropdown-menu">
              <li><%= link_to t('nav.user.my_teams'), root_path, data: { turbo_frame: "_top" } %></li>
              <li><%= link_to t('nav.user.my_calendar'), root_path, data: { turbo_frame: "_top" } %></li>
              <li><%= link_to t('sessions.sign_out'), session_path, data: { turbo_method: :delete, turbo_frame: "_top" } %></li>
            </ul>
          </div>
          <% else %>
            <%= link_to t('sessions.sign_in'), new_session_path %>
          <% end %>
        </li>
      </ul>
    </nav>
  </div>
</header>