<main class="container">
  <%= link_to sanitize("&larr; Back to leagues"), leagues_path %>
  <div class="header">
    <h1><%= @league.title %></h1>
  </div>
  <%= render "empty_state" if @teams.none? %>
  <%= turbo_frame_tag "teams", class: "teams" do %>
    <%= render @teams, league: @league %>
  <% end %>
</main>