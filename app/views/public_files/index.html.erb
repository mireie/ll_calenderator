<div class="d-flex align-items-center p-3 mx-5 flex-wrap" data-turbo-frame="filter">
  <%= form_with url: public_files_path, method: :get, remote: true, data: { controller: 'filter' } do %>

    <div class="d-flex align-items-center">
      <%= label_tag :team_name, 'Team Name', class: "me-2" %>
      <%= text_field_tag :team_name, params[:team_name], class: "form-control me-2", data: { action: 'input->filter#submit' } %>
      <%= submit_tag 'Filter', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
<div class="d-flex flex-column">
  <div class="overflow-auto">
    <div class="py-2 align-middle min-w-full px-6">
      <div class="shadow overflow-hidden border-bottom border-gray-200 rounded">
        <div class="bg-light px-4 py-5 grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="d-none lg:block h4 text-gray-900">Team</div>
          <div class="d-none lg:block h4 text-gray-900">League</div>
          <div class="d-none lg:block h4 text-gray-900">File</div>
        </div>
        <% @files.each do |file| %>
          <div class="px-4 py-5 grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="text-muted font-weight-bold h4"><%= file[:team_name] %></div>
            <div class="text-muted"><%= file[:league_name] %></div>
            <div class="text-muted">
              <%= link_to "Subscribe to Calendar", "webcal://#{request.host_with_port}/#{file[:path].gsub('public/', '')}", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>