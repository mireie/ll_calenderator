<%= turbo_frame_tag "league_#{league.id}_teams" do %>
  <div class="card__subtitle">Teams</div>
  <div class="card__teams" style="display: flex; flex-wrap: wrap;">
    <% teams.each do |team| %>
      <div class="card__team" style="flex: 1;">
        <%= team.name %>
      </div>
    <% end %>
  </div>
<%end%>
