<h1>Games</h1>

<%= form_with url: public_files_path, method: :get do %>
  <div>
    <%= label_tag :team_name, 'Team Name' %>
    <%= text_field_tag :team_name, params[:team_name] %>
  </div>
  <%= submit_tag 'Filter' %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Team ID</th>
      <th>Team Name</th>
      <th>League Name</th>
      <th>File</th>
    </tr>
  </thead>
  <tbody>
    <% @files.each do |file| %>
      <tr>
        <td><%= file[:team_id] %></td>
        <td><%= file[:team_name] %></td>
        <td><%= file[:league_name] %></td>
        <td><%= link_to File.basename(file[:path]), "/#{file[:path].gsub('public/', '')}" %></td>
      </tr>
    <% end %>
  </tbody>
</table>